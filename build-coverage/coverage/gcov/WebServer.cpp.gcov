    #####:  151:const char* requestedDashboardTabs() {
    #####:  152:    return R"JS(<script>(function(){const nav=document.querySelector('.tabs');if(!nav||nav.querySelector('[data-tab="summary"]'))return;const style=document.createElement('style');style.textContent='.tabs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:4px;padding:6px;align-items:stretch}.tabs .tab{min-width:0;min-height:42px;padding:9px 8px;white-space:normal;line-height:1.15;font-size:12px;text-align:center;display:grid;place-items:center}@media(max-width:760px){.tabs{grid-template-columns:repeat(2,minmax(0,1fr))}.tabs .tab{min-height:40px}}';document.head.appendChild(style);const add=(key,label)=>{const button=document.createElement('button');button.className='tab';button.type='button';button.dataset.tab=key;button.setAttribute('role','tab');button.setAttribute('aria-selected','false');button.textContent=label;button.onclick=()=>openTab(key);nav.appendChild(button)};add('summary','Summary Dashboard');add('global-news','Global market news');window.globalNews=async()=>{const payload=await safeJsonFetch('/api/global-news',{status:'error',error:'Global market news is unavailable right now.'}),source=payload.data||[],items=Array.isArray(source)?source:Object.entries(source).flatMap(([key,value])=>(Array.isArray(value)?value:[]).map(item=>({...item,instrument_key:key})));if(payload.status==='error'){status.textContent=payload.error||'Global market news unavailable';view.innerHTML='<div class="panel error"><div class="label">Global market news</div><h2>Live global news unavailable</h2><p>'+esc(payload.error||'The news provider did not return data.')+'</p><p>Check the access token or network connection, then use Refresh.</p></div>';return}status.textContent=items.length+' global market articles · updated '+new Date().toLocaleTimeString();view.innerHTML='<div class="panel"><h2>Global market news</h2><p>Broad market articles from the authenticated Upstox feed, not limited to portfolio holdings.</p><div class="news">'+items.map(item=>'<article class="story"><small>'+esc(item.instrument_key||item.category||'Global market')+'</small><h3>'+esc(item.heading||item.title||'Untitled article')+'</h3><p>'+esc(item.summary||item.description||'')+'</p>'+(item.article_link||item.url?'<a href="'+esc(item.article_link||item.url)+'" target="_blank" rel="noopener">Read article &rarr;</a>':'')+'</article>').join('')+'</div></div>'};window.summaryDashboard=async()=>{const [holdingsData,newsData]=await Promise.all([get('holdings','/api/holdings'),get('news','/api/news')]),rows=holdingsData.data||[],alerts=newsData.alerts||[],articles=Object.values(newsData.data||{}).reduce((total,value)=>total+(Array.isArray(value)?value.length:0),0),value=rows.reduce((total,item)=>total+holdingValue(item),0),positive=alerts.filter(item=>Number(item.sentiment_score||0)>=.3).length,risk=alerts.filter(item=>Number(item.sentiment_score||0)<=-.3).length;status.textContent='Portfolio summary · updated '+new Date().toLocaleTimeString();view.innerHTML='<div class="grid"><div class="metric"><span class="label">Stocks</span><b>'+stockCount(rows)+'</b></div><div class="metric"><span class="label">Market value</span><b>'+(holdingsData.source==='upstox-live'?'INR '+value.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}):'Unavailable · renew token')+'</b></div><div class="metric"><span class="label">News articles</span><b>'+articles+'</b></div><div class="metric"><span class="label">Positive / risk</span><b>'+positive+' / '+risk+'</b></div></div><div class="panel"><h2>Summary Dashboard</h2><p>Portfolio holdings, valuation source, news coverage, and review signals in one view.</p><table class="table"><tr><th>Area</th><th>Current state</th><th>Meaning</th></tr><tr><td>Holdings source</td><td>'+esc(holdingsData.source||'unknown')+'</td><td>Live Upstox data is preferred; fallback data is identified.</td></tr><tr><td>Portfolio value</td><td>'+(holdingsData.source==='upstox-live'?'Live valuation':'Unavailable')+'</td><td>'+(holdingsData.source==='upstox-live'?'Current holdings snapshot.':'Renew the access token to restore live valuation.')+'</td></tr><tr><td>News coverage</td><td>'+articles+' articles</td><td>Recent news filtered to configured holdings.</td></tr><tr><td>Review signals</td><td>'+positive+' positive, '+risk+' risk</td><td>Advisory only; review before acting.</td></tr></table></div>'};})()</script>)JS";
